{
  "expo": {
    "name": "Beryl Shelter",
    "slug": "beryl-shelter",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "berylshelter",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5F2",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#0D1117"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.berylshelter.mobile",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.berylshelter.mobile",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F5F2"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4eb3a6e8-1426-479c-a96c-eb7b6adc0c0a"
      }
    },
    "owner": "vicerhatech"
  }
}

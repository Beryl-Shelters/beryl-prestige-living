# This URL is embedded in the app and therefore must never contain a secret.
# For a physical device during local development, use your computer's LAN IP,
# for example http://192.168.x.x:5000/api/v1. EAS preview/production builds
# must use a deployed HTTPS API URL configured in the matching EAS environment.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api/v1

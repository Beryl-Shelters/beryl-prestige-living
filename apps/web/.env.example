# Server-only BFF upstream. Use the branded API base URL, including /api/v1.
API_BASE_URL=http://localhost:5000/api/v1
# Public browser configuration; it must match API_BASE_URL for the deployed environment.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
# Public-site and customer-app hosts. Use the same local host for local development.
NEXT_PUBLIC_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_CUSTOMER_APP_URL=http://localhost:3000

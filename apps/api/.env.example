NODE_ENV=development
PORT=5000
PUBLIC_WEB_URL=http://localhost:3000
# Comma-separated browser origins allowed by CORS. Do not use *.
CLIENT_WEB_URLS=http://localhost:3000,http://localhost:3001
API_PUBLIC_URL=http://localhost:5000/api/v1
# Documentation-only Swagger server choices. These contain no secrets.
SWAGGER_PREVIEW_API_URL=https://dev-api.berylshelter.com/api/v1
SWAGGER_PRODUCTION_API_URL=https://api.berylshelter.com/api/v1
ADMIN_WEB_URL=http://localhost:3001
ADMIN_ACTIVATION_URL=http://localhost:3001/activate

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=
OTP_HASH_SECRET=replace-with-a-unique-32-character-minimum-secret
CUSTOMER_ACCESS_TOKEN_SECRET=replace-with-a-unique-32-character-minimum-secret
CUSTOMER_REFRESH_TOKEN_SECRET=replace-with-a-different-unique-32-character-minimum-secret
ADMIN_INVITATION_TOKEN_SECRET=replace-with-a-unique-32-character-minimum-secret
ADMIN_ACCESS_TOKEN_SECRET=replace-with-a-unique-32-character-minimum-secret
ADMIN_REFRESH_TOKEN_SECRET=replace-with-a-different-unique-32-character-minimum-secret

CUSTOMER_ACCESS_TOKEN_EXPIRES_IN=900
CUSTOMER_REFRESH_TOKEN_EXPIRES_IN=2592000
CUSTOMER_PASSWORD_RESET_PROOF_EXPIRES_IN=600
ADMIN_ACCESS_TOKEN_EXPIRES_IN=900
ADMIN_REFRESH_TOKEN_EXPIRES_IN=2592000
ADMIN_INVITATION_EXPIRES_IN_SECONDS=86400
ADMIN_ACTIVATION_OTP_EXPIRY_MINUTES=10
ADMIN_ACTIVATION_OTP_MAX_ATTEMPTS=3
ADMIN_ACTIVATION_OTP_RESEND_COOLDOWN_SECONDS=60
ADMIN_LOGIN_OTP_EXPIRY_MINUTES=10
ADMIN_LOGIN_OTP_MAX_ATTEMPTS=3
ADMIN_LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60
ADMIN_PASSWORD_CHANGE_PROOF_EXPIRES_IN=600

RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@example.com
RESEND_FROM_NAME=Beryl Shelter Nigeria Limited
MIXPANEL_CUSTOMER_TOKEN=

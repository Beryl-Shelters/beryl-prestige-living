PORT=
NODE_ENV=
WEB_APP_URL=
API_PUBLIC_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_OR_SERVICE_ROLE_KEY

# 32 cryptographically random bytes, base64 encoded. Server only; keep stable
# across API instances/restarts. Rotation invalidates active application sessions.
AUTH_ENCRYPTION_KEY=
# Blank defaults: Secure in production, SameSite=lax, seven-day absolute session.
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAME_SITE=
AUTH_SESSION_SECONDS=
AUTH_RATE_WINDOW_MS=
AUTH_RATE_LIMIT=
# Enable only after the external Supabase Google provider is configured.
AUTH_GOOGLE_ENABLED=false

# Minimum customer referral withdrawal in exact NGN minor units. Default ₦100.
REFERRAL_WITHDRAWAL_MINIMUM_MINOR=10000

# Admin invitations. All three values are required to enable Admin API routes.
ADMIN_APP_URL=
RESEND_API_KEY=
ADMIN_INVITE_FROM_EMAIL=
# Default 172800 seconds (48 hours); allowed range 1 hour to 7 days.
ADMIN_INVITE_EXPIRY_SECONDS=172800
# Number of trusted reverse proxies. Default 0; configure the actual platform hop count.
TRUST_PROXY_HOPS=0

# Server-side listing media uploads. No browser secret or unsigned preset Beryl@admin2026_biola.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
